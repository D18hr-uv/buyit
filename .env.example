# ---- LLM configuration ----
# Leave OPENAI_API_KEY empty (or use a key without quota) to run in deterministic STUB mode.
# The app is fully functional in stub mode; a usable key enables real LLM reasoning.
OPENAI_API_KEY=
LLM_PROVIDER=openai            # openai | stub  (auto-falls back to stub if key unusable)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- Database (PostgreSQL; e.g. Neon cloud) ----
# SQLAlchemy URL. Example (Neon):
# postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# ---- Agent guardrails ----
MAX_AGENT_ITERS=3
APPROVAL_VALUE_THRESHOLD=50000     # PO value above which human approval is required
MIN_SUPPLIER_RELIABILITY=0.7       # vendors below this trigger approval/escalation

# ---- CORS ----
# "*" allows any origin (fine for local dev). In production set a comma-separated
# allowlist of your frontend origin(s), e.g. https://buyit.vercel.app
CORS_ORIGINS=*

# ---- Frontend ----
# Baked into the build at build time. Point it at the deployed API in production,
# e.g. https://buyit-api.onrender.com
VITE_API_URL=http://localhost:8000
