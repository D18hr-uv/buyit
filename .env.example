# ---- LLM configuration ----
# Leave OPENAI_API_KEY empty to run in deterministic STUB mode (no external calls).
# The app is fully functional in stub mode; a key only enables real LLM reasoning.
OPENAI_API_KEY=
LLM_PROVIDER=openai          # openai | stub  (auto-falls back to stub if no key)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- Data layer ----
DATABASE_URL=postgresql+psycopg://buyer:buyer@postgres:5432/buyit
REDIS_URL=redis://redis:6379/0

# ---- Agent guardrails ----
MAX_AGENT_ITERS=3
APPROVAL_VALUE_THRESHOLD=50000     # PO value (currency units) above which HITL approval is required
MIN_SUPPLIER_RELIABILITY=0.7       # below this, escalate/require approval

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
